# Production env for the docker-compose.prod.yml stack.
# On the server:  cp deploy/env.production.example .env.production  and fill in.
# NEVER commit the real file.
#
#   openssl rand -hex 32     # -> JWT_SECRET
#   openssl rand -hex 32     # -> API_SERVICE_TOKEN

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

# `mongo` / `redis` are the compose service names on the internal network.
DATABASE_URL=mongodb://mongo:27017/abzar?replicaSet=rs0
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated. The storefront + backoffice origins.
CORS_ORIGIN=https://example.com,https://panel.example.com

# Shared secret for X-Service-Token (BFF -> API).
API_SERVICE_TOKEN=CHANGE_ME

# --- OTP ---
OTP_DEV_ECHO=false
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# --- SMS (Melipayamak) ---
SMS_PROVIDER=melipayamak
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_OTP_PATTERN_ID=
MELIPAYAMAK_ORDER_PAID_PATTERN_ID=
MELIPAYAMAK_ORDER_STATUS_PATTERN_ID=
MELIPAYAMAK_ABANDONED_CART_PATTERN_ID=

# --- Payment (ZarinPal) ---
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# `${PAYMENT_CALLBACK_BASE_URL}/api/v1/payment/callback` must be publicly reachable.
PAYMENT_CALLBACK_BASE_URL=https://api.example.com
PAYMENT_RESULT_REDIRECT_URL=https://example.com/checkout/result

# --- S3-compatible object storage (ArvanCloud / Liara / …) ---
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Read by prisma/seed.ts only.
SEED_SUPERADMIN_MOBILE=09383545997
