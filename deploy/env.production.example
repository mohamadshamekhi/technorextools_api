# Production env for the docker-compose.prod.yml stack.
# On the server:  cp deploy/env.production.example .env.production  and fill in.
# NEVER commit the real file.
#
#   openssl rand -hex 32     # -> JWT_SECRET
#   openssl rand -hex 32     # -> API_SERVICE_TOKEN

NODE_ENV=production
PORT=4000
API_PREFIX=api/v1

# `mongo` / `redis` are the compose service names on the internal network.
DATABASE_URL=mongodb://mongo:27017/abzar?replicaSet=rs0
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated, exact origins (scheme + host, no trailing slash). Both the www and
# bare hosts are listed because a browser sends whichever the user actually loaded.
CORS_ORIGIN=https://www.technorextools.com,https://technorextools.com,https://www.backoffice.technorextools.com,https://backoffice.technorextools.com

# Shared secret for X-Service-Token (BFF -> API).
API_SERVICE_TOKEN=CHANGE_ME

# --- OTP ---
OTP_DEV_ECHO=false
OTP_TTL_SECONDS=120
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# --- SMS (Melipayamak) ---
SMS_PROVIDER=melipayamak
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_OTP_PATTERN_ID=
MELIPAYAMAK_ORDER_PAID_PATTERN_ID=
MELIPAYAMAK_ORDER_STATUS_PATTERN_ID=
MELIPAYAMAK_ABANDONED_CART_PATTERN_ID=

# --- Payment ---
# `fake` AUTO-SUCCEEDS every payment without a gateway — orders become `paid` and stock
# is deducted for free. Fine while the gateway isn't ready; switch to `zarinpal` (+
# ZARINPAL_MERCHANT_ID, ZARINPAL_SANDBOX=false) before real customers reach checkout.
PAYMENT_PROVIDER=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
# `${PAYMENT_CALLBACK_BASE_URL}/api/v1/payment/callback` must be publicly reachable.
PAYMENT_CALLBACK_BASE_URL=https://api.technorextools.com
PAYMENT_RESULT_REDIRECT_URL=https://www.technorextools.com/checkout/result

# --- S3 object storage (ArvanCloud) ---
# Endpoint + region come from the ArvanCloud panel; ir-thr-at1 is the Tehran zone.
# S3_PUBLIC_BASE_URL is what image URLs are built from — the bucket must be public-read.
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://<bucket>.s3.ir-thr-at1.arvanstorage.ir

# Read by prisma/seed.ts only.
SEED_SUPERADMIN_MOBILE=09383545997
