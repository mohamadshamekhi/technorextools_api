# ── Runtime ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# ── Database ─────────────────────────────────────────────────────
# Prisma + MongoDB requires a replica set (needed for transactions).
# serverSelectionTimeoutMS keeps requests from hanging ~30s when the DB is unreachable.
DATABASE_URL=mongodb://localhost:27017/abzar?replicaSet=rs0&serverSelectionTimeoutMS=5000

# ── Auth (JWT session) ───────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── OTP login ────────────────────────────────────────────────────
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
# Dev only: return the OTP code in the /auth/otp/request response. MUST be false in production.
OTP_DEV_ECHO=true

# ── SMS provider ─────────────────────────────────────────────────
# 'console' just logs the message. 'melipayamak' sends OTP via MelliPayamak's
# service-pattern endpoint (BaseServiceNumber) — the three MELIPAYAMAK_* keys are
# then required. OTP pattern must have a single variable slot for the code.
SMS_PROVIDER=console
# Auth: set MELIPAYAMAK_API_KEY (preferred, console.melipayamak.com) OR username+password.
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_USERNAME=989120207494
MELIPAYAMAK_PASSWORD=e1a01301-3de5-4492-8972-27ee9cb633e5
# Transactional notification patterns (optional). Create + get approval in the panel;
# unset → that notification is logged instead of sent. Variable slots:
#   ORDER_PAID: {0}=order number   ORDER_STATUS: {0}=order number {1}=status   ABANDONED_CART: {0}=item count
# Registered pattern ids (pending panel approval - usable only once approved):
MELIPAYAMAK_OTP_PATTERN_ID=534142
MELIPAYAMAK_ORDER_PAID_PATTERN_ID=534143
MELIPAYAMAK_ORDER_STATUS_PATTERN_ID=534144
MELIPAYAMAK_ABANDONED_CART_PATTERN_ID=534146

# ── Payment gateway ─────────────────────────────────────────────
# 'fake' auto-succeeds (dev/CI). 'zarinpal' calls ZarinPal v4 REST — ZARINPAL_MERCHANT_ID
# is then required. PAYMENT_CALLBACK_BASE_URL must be reachable by the user's browser
# ({base}/api/v1/payment/callback). PAYMENT_RESULT_REDIRECT_URL is the storefront page
# the browser lands on after payment (gets ?orderNumber=&status=).
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=95fc0a85-fccc-40bc-a0df-1d5d16c1a96e
ZARINPAL_SANDBOX=false
PAYMENT_CALLBACK_BASE_URL=https://api.technorextools.com
PAYMENT_RESULT_REDIRECT_URL=https://technorextools.com/checkout/result
# PAYMENT_CALLBACK_BASE_URL=http://localhost:4000
# PAYMENT_RESULT_REDIRECT_URL=http://localhost:3000/checkout/result

# ── Redis (optional) ─────────────────────────────────────────────
# Only needed when running more than one API instance: the global rate-limiter
# then shares its counters here instead of per-process memory. Leave unset for
# single-instance. `docker compose up -d redis` provides one locally.
REDIS_URL=

# ── Service-to-service ───────────────────────────────────────────
# Optional shared secret for server-only callers (storefront/backoffice BFF).
API_SERVICE_TOKEN=

# ── Object storage (admin image uploads, S3-compatible) ─────────
# All five required to enable POST /backoffice/media/presign (else it returns 503).
# Path-style addressing. Examples: ArvanCloud (endpoint https://s3.ir-thr-at1.arvanstorage.ir,
# region ir-thr-at1) · Liara (https://storage.iran.liara.space, region default).
S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
S3_REGION=ir-thr-at1
S3_BUCKET=technorex-media
S3_ACCESS_KEY_ID=f4a38d44-58d4-4ada-b499-23012f5579ef
S3_SECRET_ACCESS_KEY=6abff873845fff70ec744c586770f791aee33dc570827f26434f9323f00b7a44
S3_PUBLIC_BASE_URL=https://technorex-media.s3.ir-thr-at1.arvanstorage.ir

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Seed ─────────────────────────────────────────────────────────
SEED_SUPERADMIN_MOBILE=09120000000
