{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "concise-fa",
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm build)",
      "Bash(pnpm test:*)",
      "Bash(pnpm format:check)",
      "Bash(pnpm prisma:generate)",
      "Bash(pnpm dev:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(node:*)",
      "Bash(npx prisma:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./pnpm-lock.yaml)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./node_modules/**)",
      "Read(./.git/**)",
      "Bash(git push:*)",
      "Bash(pnpm prisma:push)",
      "Bash(pnpm prisma:seed)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)"
    ]
  }
}
